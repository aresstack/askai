{
  "manifest_version": 3,
  "name": "AskAI Research",
  "version": "0.2.0",
  "description": "AskAI research browser controls. Shows the research HUD in the browser UI and reads pages from the isolated content-script world instead of the visited page.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AskAI Research"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
