{
  "manifest_version": 2,
  "name": "AskAI Research",
  "version": "0.1.0",
  "description": "AskAI research browser controls. Shows the research HUD in the browser UI instead of inside the visited page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "research-hud@askai.aresstack.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "AskAI Research",
    "default_icon": "icon.svg",
    "default_popup": "panel.html",
    "default_area": "navbar"
  },
  "sidebar_action": {
    "default_title": "AskAI Research",
    "default_icon": "icon.svg",
    "default_panel": "panel.html",
    "open_at_install": true
  }
}
